@@ -0,0 +1,20 @@
+package constant
+
+import "testing"
+
+func TestNoPingStackRoundTrip(t *testing.T) {
+	var stack TUNStack
+	if err := stack.UnmarshalText([]byte("gvisor-no-ping")); err != nil {
+		t.Fatal(err)
+	}
+	if stack != TunGvisorNoPing {
+		t.Fatal("no-ping policy lost during parsing")
+	}
+	value, err := stack.MarshalText()
+	if err != nil || string(value) != "gvisor-no-ping" {
+		t.Fatal("controller/config must expose the no-ping policy")
+	}
+	if err := stack.UnmarshalText([]byte("gvisor-unknown")); err == nil {
+		t.Fatal("unknown stack must fail configuration validation")
+	}
+}
