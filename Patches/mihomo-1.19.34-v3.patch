@@ -0,0 +1,31 @@
+package sing_tun
+
+import (
+	"net/netip"
+	"runtime"
+	"testing"
+)
+
+func TestMimoNativeRouteDoesNotBindQuad100ToPhysicalDefault(t *testing.T) {
+	for _, address := range []string{"100.64.0.0", "100.100.100.100", "100.127.255.255", "::ffff:100.100.100.100", "fd7a:115c:a1e0::53"} {
+		ip := netip.MustParseAddr(address)
+		if !mimoNativeRoute(ip) {
+			t.Fatal(address)
+		}
+		if runtime.GOOS == "darwin" {
+			// No monitor is installed: reaching the normal interface-selection path
+			// would panic, rather than merely returning the expected empty string.
+			if got := (&cDialerInterfaceFinder{}).FindInterfaceName(ip); got != "" {
+				t.Fatalf("%s: %s", address, got)
+			}
+		}
+	}
+	for _, address := range []string{"100.63.255.255", "100.128.0.0", "1.1.1.1", "192.168.1.1", "2001:db8::1", "fd7a:115c:a1e1::1", "64:ff9b::6464:6464"} {
+		if mimoNativeRoute(netip.MustParseAddr(address)) {
+			t.Fatal(address)
+		}
+	}
+	if mimoNativeRoute(netip.Addr{}) {
+		t.Fatal("invalid destination")
+	}
+}
