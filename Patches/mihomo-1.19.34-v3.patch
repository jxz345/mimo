diff --git a/tunnel/mimo_policy.go b/tunnel/mimo_policy.go
new file mode 100644
index 0000000..fc3686c
--- /dev/null
+++ b/tunnel/mimo_policy.go
@@ -0,0 +1,93 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	"github.com/metacubex/mihomo/component/resolver"
+	C "github.com/metacubex/mihomo/constant"
+	"net/netip"
+	"strings"
+	"sync/atomic"
+)
+
+var mimoIPv4Only atomic.Bool
+
+func SetMimoDestinationFamily(family string) { mimoIPv4Only.Store(family == "ipv4") }
+func MimoDestinationFamily() string {
+	if mimoIPv4Only.Load() {
+		return "ipv4"
+	}
+	return "dual"
+}
+
+// Run before fake-IP restoration and sniffing: a literal IPv6 request cannot
+// acquire an IPv4 hostname and evade the destination policy.
+func mimoRejectLiteral(m *C.Metadata) bool {
+	return mimoIPv4Only.Load() && m.DstIP.Is6() && !m.DstIP.Is4In6()
+}
+
+// Routing uses the original host. Only the outbound copy loses it, after rule
+// classification and sniffing, so SOCKS/CONNECT cannot remotely resolve to AAAA.
+func mimoDialMetadata(ctx context.Context, m *C.Metadata, resolve func(context.Context, string) (netip.Addr, error)) (*C.Metadata, error) {
+	if m.InName == "mimo-private-probe" && (m.InUser == "mimo-core-ipv4" || m.InUser == "mimo-core-ipv6") {
+		if err := mimoProbeAdmission(m); err != nil {
+			return nil, err
+		}
+		if mimoIPv4Only.Load() && m.InUser == "mimo-core-ipv6" {
+			return nil, errors.New("IPv6 probe denied in IPv4 mode")
+		}
+		resolve := resolver.ResolveIPv4
+		if m.InUser == "mimo-core-ipv6" {
+			resolve = resolver.ResolveIPv6
+		}
+		ip, err := resolve(ctx, m.Host)
+		if err != nil {
+			return nil, err
+		}
+		if (m.InUser == "mimo-core-ipv4" && !ip.Is4()) || (m.InUser == "mimo-core-ipv6" && !ip.Is6()) {
+			return nil, errors.New("probe destination family mismatch")
+		}
+		result := m.Clone()
+		result.DstIP = ip
+		result.Host = ""
+		result.DNSMode = C.DNSMapping
+		return result, nil
+	}
+	if !mimoIPv4Only.Load() {
+		return m, nil
+	}
+	if mimoRejectLiteral(m) {
+		return nil, errors.New("IPv6 destination rejected by Mimo IPv4 policy")
+	}
+	result := m.Clone()
+	if m.Host != "" {
+		ip, err := resolve(ctx, m.Host)
+		if err != nil {
+			return nil, err
+		}
+		result.DstIP = ip.Unmap()
+	}
+	if !result.DstIP.Is4() {
+		return nil, errors.New("Mimo requires an IPv4 destination")
+	}
+	result.Host = ""
+	result.DNSMode = C.DNSMapping
+	return result, nil
+}
+
+// Auth is checked by the listener; restrict its authenticated principal and
+// destinations here, before SpecialProxy or Global dispatch can bypass rules.
+func mimoProbeAdmission(m *C.Metadata) error {
+	if m.InName != "mimo-private-probe" && m.SpecialRules != "mimo-verification" {
+		return nil
+	}
+	if m.InName != "mimo-private-probe" || m.SpecialRules != "mimo-verification" ||
+		(m.InUser != "mimo-core" && m.InUser != "mimo-core-ipv4" && m.InUser != "mimo-core-ipv6") || m.NetWork != C.TCP || m.DstPort != 443 {
+		return errors.New("Mimo private probe denied")
+	}
+	switch strings.ToLower(strings.TrimSuffix(m.Host, ".")) {
+	case "api.ipinfo.io", "v4.api.ipinfo.io", "v6.api.ipinfo.io", "ipapi.co", "ipwho.is", "api.ipapi.is", "api4.ipify.org", "api6.ipify.org":
+		return nil
+	}
+	return errors.New("Mimo private probe destination denied")
+}
diff --git a/tunnel/mimo_policy_test.go b/tunnel/mimo_policy_test.go
new file mode 100644
index 0000000..ca9cd1f
--- /dev/null
+++ b/tunnel/mimo_policy_test.go
@@ -0,0 +1,61 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	C "github.com/metacubex/mihomo/constant"
+	"net/netip"
+	"testing"
+)
+
+func TestMimoIPv4Pinning(t *testing.T) {
+	SetMimoDestinationFamily("ipv4")
+	defer SetMimoDestinationFamily("dual")
+	for _, ip := range []string{"2001:db8::1", "64:ff9b::c000:201", "64:ff9b:1::c000:201"} {
+		m := &C.Metadata{DstIP: netip.MustParseAddr(ip)}
+		if !mimoRejectLiteral(m) {
+			t.Fatal("IPv6 ingress accepted", ip)
+		}
+		if _, err := mimoDialMetadata(context.Background(), m, nil); err == nil {
+			t.Fatal("IPv6 outbound accepted")
+		}
+	}
+	for _, network := range []C.NetWork{C.TCP, C.UDP} {
+		original := &C.Metadata{Host: "dual.example", NetWork: network}
+		got, err := mimoDialMetadata(context.Background(), original, func(context.Context, string) (netip.Addr, error) { return netip.MustParseAddr("192.0.2.1"), nil })
+		if err != nil || got.Host != "" || !got.DstIP.Is4() || original.Host != "dual.example" {
+			t.Fatalf("destination not pinned: %v %v", got, err)
+		}
+		if _, err := mimoDialMetadata(context.Background(), original, func(context.Context, string) (netip.Addr, error) { return netip.Addr{}, errors.New("no A") }); err == nil {
+			t.Fatal("missing A accepted")
+		}
+		if _, err := mimoDialMetadata(context.Background(), original, func(context.Context, string) (netip.Addr, error) { return netip.MustParseAddr("2001:db8::1"), nil }); err == nil {
+			t.Fatal("resolver AAAA accepted")
+		}
+	}
+}
+
+func TestMimoProbeBeforeGlobal(t *testing.T) {
+	previous := mode
+	mode = Global
+	defer func() { mode = previous }()
+	valid := C.Metadata{InName: "mimo-private-probe", SpecialRules: "mimo-verification", InUser: "mimo-core", Host: "v6.api.ipinfo.io", NetWork: C.TCP, DstPort: 443}
+	if err := mimoProbeAdmission(&valid); err != nil {
+		t.Fatal(err)
+	}
+	changes := []func(*C.Metadata){
+		func(m *C.Metadata) { m.Host = "example.com" },
+		func(m *C.Metadata) { m.Host = "v6.api.ipinfo.io.attacker.example" },
+		func(m *C.Metadata) { m.DstPort = 80 },
+		func(m *C.Metadata) { m.NetWork = C.UDP },
+		func(m *C.Metadata) { m.InUser = "" },
+		func(m *C.Metadata) { m.SpecialRules = "unknown" },
+	}
+	for _, change := range changes {
+		m := valid
+		change(&m)
+		if _, _, err := resolveMetadata(&m); err == nil {
+			t.Fatal("Global bypassed probe admission", m)
+		}
+	}
+}
