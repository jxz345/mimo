 func (f *ICMPForwarder) HandlePacket(id stack.TransportEndpointID, pkt *stack.PacketBuffer) bool {
+	// Optional policy: drop echo requests before direct forwarding or synthetic
+	// replies, including requests addressed to the TUN itself. Other ICMP types
+	// retain their normal stack handling (PMTU, neighbor/router discovery, etc.).
+	policy, _ := f.handler.(interface{ BlockICMPEcho() bool })
 	if pkt.NetworkProtocolNumber == header.IPv4ProtocolNumber {
 		ipHdr := header.IPv4(pkt.NetworkHeader().Slice())
 		icmpHdr := header.ICMPv4(pkt.TransportHeader().Slice())
+		if icmpHdr.Type() == header.ICMPv4Echo && policy != nil && policy.BlockICMPEcho() {
+			return true
+		}
 		if icmpHdr.Type() != header.ICMPv4Echo || icmpHdr.Code() != 0 {
 			return false
